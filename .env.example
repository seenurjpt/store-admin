# Main database (matches the Postgres service in docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_admin"

# Separate database used by integration and E2E tests. It is wiped on every test run.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_admin_test"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=""
